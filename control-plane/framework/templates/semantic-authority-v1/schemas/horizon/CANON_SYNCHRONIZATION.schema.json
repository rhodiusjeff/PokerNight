{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://control-plane.dev/schemas/semantic-authority-v1/horizon/CANON_SYNCHRONIZATION.schema.json",
 "$comment": "LOCAL ADDITION semantic-authority-v1 - HARVEST TO CPB.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "horizon_id", "entries"],
 "properties": {
  "schema": {"const": "cpb-semantic-authority-v1/canon-synchronization"},
  "horizon_id": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/horizonId"},
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "horizon_id", "operation", "local_origin", "canon_baseline_digest", "expected_preimage", "postimage", "postimage_digest", "affected_refs", "lineage", "required_boundary"],
    "properties": {
     "id": {"type": "string", "minLength": 1},
     "horizon_id": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/horizonId"},
    "operation": {"enum": ["add", "amend", "supersede", "retire"]},
     "local_origin": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/localRef"},
     "target": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/canonRef"},
     "requested_new_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_kind"],
      "properties": {
       "id": {"type": "string", "minLength": 1},
       "entity_kind": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/entityKind"}
      }
     },
     "canon_baseline_digest": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/digest"},
     "expected_preimage": {"oneOf": [{"const": "absent"}, {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/digest"}]},
    "postimage": {
     "type": "object",
     "required": ["id", "entity_kind", "lifecycle"],
     "properties": {
      "id": {"type": "string", "minLength": 1},
      "entity_kind": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/entityKind"},
      "lifecycle": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/lifecycle"}
     }
    },
     "postimage_digest": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/digest"},
     "affected_refs": {"type": "array", "items": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/canonRef"}},
     "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/lineageRef"}},
     "required_boundary": {"enum": ["canon-review", "promotion"]}
    },
    "allOf": [
     {
      "if": {"properties": {"operation": {"const": "add"}}},
      "then": {"required": ["requested_new_identity"], "not": {"required": ["target"]}},
      "else": {"required": ["target"], "not": {"required": ["requested_new_identity"]}}
     },
     {
      "if": {"properties": {"operation": {"const": "add"}}},
      "then": {"properties": {"expected_preimage": {"const": "absent"}}},
      "else": {"properties": {"expected_preimage": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/digest"}}}
    },
    {
     "if": {"properties": {"operation": {"const": "add"}}},
     "then": {"properties": {"postimage": {"properties": {"lifecycle": {"const": "active"}}}}}
    },
    {
     "if": {"properties": {"operation": {"const": "supersede"}}},
     "then": {"properties": {"postimage": {"properties": {"lifecycle": {"const": "superseded"}}}}}
    },
    {
     "if": {"properties": {"operation": {"const": "retire"}}},
     "then": {"properties": {"postimage": {"properties": {"lifecycle": {"const": "retired"}}}}}
     }
    ]
   }
  }
 }
}