{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json",
 "$comment":"LOCAL ADDITION semantic-authority-v1 2026-07-30 - HARVEST TO CPB.",
 "$defs":{
  "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "gitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
  "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
  "horizonId":{"type":"string","pattern":"^H[0-9]{3}$"},
  "entityKind":{"enum":["requirement","behavior","acceptance-scenario","outcome"]},
  "localKind":{"enum":["requirement","user-story","acceptance-scenario"]},
  "lifecycle":{"enum":["active","superseded","retired"]},
    "receiptRef":{"type":"object","additionalProperties":false,"required":["ref_type","receipt_kind","scope","receipt_id","artifact_digest"],"properties":{"ref_type":{"const":"receipt"},"receipt_kind":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"receipt_id":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"},"event_commit":{"$ref":"#/$defs/gitSha"}}},
    "completionReceiptRef":{"type":"object","additionalProperties":false,"required":["ref_type","receipt_kind","scope","receipt_id","artifact_digest","event_commit"],"properties":{"ref_type":{"const":"receipt"},"receipt_kind":{"const":"acceptance-completion"},"scope":{"$ref":"#/$defs/horizonId"},"receipt_id":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"},"event_commit":{"$ref":"#/$defs/gitSha"}}},
  "alias":{"type":"object","additionalProperties":false,"required":["value","entity_kind","permanence","source_receipt"],"properties":{"value":{"type":"string","minLength":1},"entity_kind":{"$ref":"#/$defs/entityKind"},"permanence":{"enum":["permanent","temporary"]},"source_receipt":{"$ref":"#/$defs/receiptRef"},"retirement_rationale":{"type":"string","minLength":1}}},
  "canonRef":{"type":"object","additionalProperties":false,"required":["ref_type","entity_kind","id","baseline_digest"],"properties":{"ref_type":{"const":"canon"},"entity_kind":{"$ref":"#/$defs/entityKind"},"id":{"type":"string","minLength":1},"baseline_digest":{"$ref":"#/$defs/digest"}}},
  "sourceRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","source_id","location","content_digest"],"properties":{"ref_type":{"const":"source"},"horizon_id":{"$ref":"#/$defs/horizonId"},"source_id":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"},"location":{"type":"string","minLength":1},"content_digest":{"$ref":"#/$defs/digest"}}},
  "inferenceRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","inference_id","source_set_digest","inference_digest"],"properties":{"ref_type":{"const":"inference"},"horizon_id":{"$ref":"#/$defs/horizonId"},"inference_id":{"type":"string","pattern":"^IIR-[A-Z0-9-]+$"},"source_set_digest":{"$ref":"#/$defs/digest"},"inference_digest":{"$ref":"#/$defs/digest"}}},
  "localRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","local_kind","local_id","artifact_digest"],"properties":{"ref_type":{"const":"local"},"horizon_id":{"$ref":"#/$defs/horizonId"},"local_kind":{"$ref":"#/$defs/localKind"},"local_id":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"}}},
  "phaseRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","phase_id","prompt_path","prompt_digest"],"properties":{"ref_type":{"const":"phase"},"horizon_id":{"$ref":"#/$defs/horizonId"},"phase_id":{"type":"string","pattern":"^CP-[A-Za-z0-9-]+$"},"prompt_path":{"type":"string","minLength":1},"prompt_digest":{"$ref":"#/$defs/digest"}}},
  "evidenceRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","evidence_id","location","content_digest","producer_phase","result","limitations"],"properties":{"ref_type":{"const":"evidence"},"horizon_id":{"$ref":"#/$defs/horizonId"},"evidence_id":{"type":"string","minLength":1},"location":{"type":"string","minLength":1},"content_digest":{"$ref":"#/$defs/digest"},"producer_phase":{"$ref":"#/$defs/phaseRef"},"result":{"enum":["pass","fail","blocked"]},"limitations":{"type":"array","items":{"type":"string","minLength":1}}}},
  "synchronizationRef":{"type":"object","additionalProperties":false,"required":["ref_type","horizon_id","synchronization_id","artifact_digest"],"properties":{"ref_type":{"const":"synchronization"},"horizon_id":{"$ref":"#/$defs/horizonId"},"synchronization_id":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"}}},
  "proposalRef":{"type":"object","additionalProperties":false,"required":["ref_type","transaction_id","proposal_digest"],"properties":{"ref_type":{"const":"promotion-proposal"},"transaction_id":{"type":"string","minLength":1},"proposal_digest":{"$ref":"#/$defs/digest"}}},
  "lineageRef":{"oneOf":[{"$ref":"#/$defs/sourceRef"},{"$ref":"#/$defs/inferenceRef"}]},
  "requirementEntity":{"type":"object","additionalProperties":false,"required":["id","entity_kind","statement","lifecycle","aliases","lineage"],"properties":{"id":{"type":"string","minLength":1},"entity_kind":{"const":"requirement"},"statement":{"type":"string","minLength":1},"lifecycle":{"$ref":"#/$defs/lifecycle"},"aliases":{"type":"array","items":{"$ref":"#/$defs/alias"}},"lineage":{"type":"array","items":{"$ref":"#/$defs/lineageRef"}}}},
  "behaviorEntity":{"type":"object","additionalProperties":false,"required":["id","entity_kind","statement","acceptance_signal","lifecycle","aliases","lineage"],"properties":{"id":{"type":"string","minLength":1},"entity_kind":{"const":"behavior"},"statement":{"type":"string","minLength":1},"acceptance_signal":{"type":"string","minLength":1},"lifecycle":{"$ref":"#/$defs/lifecycle"},"aliases":{"type":"array","items":{"$ref":"#/$defs/alias"}},"lineage":{"type":"array","items":{"$ref":"#/$defs/lineageRef"}}}},
  "acceptanceEntity":{"type":"object","additionalProperties":false,"required":["id","entity_kind","scenario","expected_evidence_class","lifecycle","aliases","lineage"],"properties":{"id":{"type":"string","minLength":1},"entity_kind":{"const":"acceptance-scenario"},"scenario":{"type":"string","minLength":1},"expected_evidence_class":{"type":"string","minLength":1},"lifecycle":{"$ref":"#/$defs/lifecycle"},"aliases":{"type":"array","items":{"$ref":"#/$defs/alias"}},"lineage":{"type":"array","items":{"$ref":"#/$defs/lineageRef"}}}},
  "outcomeEntity":{"type":"object","additionalProperties":false,"required":["id","entity_kind","statement","lifecycle","aliases","lineage"],"properties":{"id":{"type":"string","minLength":1},"entity_kind":{"const":"outcome"},"statement":{"type":"string","minLength":1},"lifecycle":{"$ref":"#/$defs/lifecycle"},"aliases":{"type":"array","items":{"$ref":"#/$defs/alias"}},"lineage":{"type":"array","items":{"$ref":"#/$defs/lineageRef"}}}},
  "sourceRecord":{"type":"object","additionalProperties":false,"required":["id","horizon_id","location","content_digest"],"properties":{"id":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"},"horizon_id":{"$ref":"#/$defs/horizonId"},"location":{"type":"string","minLength":1},"content_digest":{"$ref":"#/$defs/digest"}}},
  "inferenceRecord":{"type":"object","additionalProperties":false,"required":["id","horizon_id","statement","source_refs","source_set_digest","inference_digest"],"properties":{"id":{"type":"string","pattern":"^IIR-[A-Z0-9-]+$"},"horizon_id":{"$ref":"#/$defs/horizonId"},"statement":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceRef"}},"source_set_digest":{"$ref":"#/$defs/digest"},"inference_digest":{"$ref":"#/$defs/digest"}}},
  "localRequirement":{"$ref":"#/$defs/localEntityRequirement"},
  "localStory":{"$ref":"#/$defs/localEntityStory"},
  "localAcceptance":{"$ref":"#/$defs/localEntityAcceptance"},
  "localEntityRequirement":{"type":"object","additionalProperties":false,"required":["id","horizon_id","local_kind","statement","artifact_digest","canon_refs","source_refs","inference_refs"],"properties":{"id":{"type":"string","pattern":"^HREQ-[A-Z0-9-]+$"},"horizon_id":{"$ref":"#/$defs/horizonId"},"local_kind":{"const":"requirement"},"statement":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"},"canon_refs":{"type":"array","items":{"$ref":"#/$defs/canonRef"}},"source_refs":{"type":"array","items":{"$ref":"#/$defs/sourceRef"}},"inference_refs":{"type":"array","items":{"$ref":"#/$defs/inferenceRef"}}}},
  "localEntityStory":{"type":"object","additionalProperties":false,"required":["id","horizon_id","local_kind","statement","artifact_digest","canon_refs","source_refs","inference_refs"],"properties":{"id":{"type":"string","pattern":"^HUS-[A-Z0-9-]+$"},"horizon_id":{"$ref":"#/$defs/horizonId"},"local_kind":{"const":"user-story"},"statement":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"},"canon_refs":{"type":"array","items":{"$ref":"#/$defs/canonRef"}},"source_refs":{"type":"array","items":{"$ref":"#/$defs/sourceRef"}},"inference_refs":{"type":"array","items":{"$ref":"#/$defs/inferenceRef"}}}},
  "localEntityAcceptance":{"type":"object","additionalProperties":false,"required":["id","horizon_id","local_kind","scenario","expected_evidence_class","artifact_digest","canon_refs","source_refs","inference_refs"],"properties":{"id":{"type":"string","pattern":"^HAT-[A-Z0-9-]+$"},"horizon_id":{"$ref":"#/$defs/horizonId"},"local_kind":{"const":"acceptance-scenario"},"scenario":{"type":"string","minLength":1},"expected_evidence_class":{"type":"string","minLength":1},"artifact_digest":{"$ref":"#/$defs/digest"},"canon_refs":{"type":"array","items":{"$ref":"#/$defs/canonRef"}},"source_refs":{"type":"array","items":{"$ref":"#/$defs/sourceRef"}},"inference_refs":{"type":"array","items":{"$ref":"#/$defs/inferenceRef"}}}}
 }
}