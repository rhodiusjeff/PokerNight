{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "LOCAL ADDITION 2026-07-30 - HARVEST TO CPB: portfolio laydown consumed by successor realization.",
  "$id": "cpb-successor-portfolio-v1",
  "title": "CPB successor portfolio",
  "type": "object",
  "required": ["schema", "source_horizon", "target", "successors"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "cpb-successor-portfolio-v1"},
    "source_horizon": {"type": "string", "pattern": "^H[0-8][0-9]{2}$"},
    "target": {
      "type": "object",
      "required": ["remote", "branch"],
      "additionalProperties": false,
      "properties": {
        "remote": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "successors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["portfolio_id", "slug", "title", "owner", "env", "depends_on", "existing_dependencies", "seed"],
        "additionalProperties": false,
        "properties": {
          "portfolio_id": {"type": "string", "pattern": "^PORT-[0-9]{3}$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": ["string", "null"]},
          "env": {"type": ["string", "null"]},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PORT-[0-9]{3}$"}},
          "existing_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^H[0-8][0-9]{2}$"}},
          "seed": {
            "type": "object",
            "required": ["objective", "scope", "source_refs", "requirements", "user_stories", "acceptance_scenarios"],
            "additionalProperties": true,
            "properties": {
              "objective": {"type": "string", "minLength": 1},
              "scope": {"type": "array", "items": {"type": "string"}},
              "source_refs": {"type": "array", "items": {"type": "string"}},
              "requirements": {"type": "array"},
              "user_stories": {"type": "array"},
              "acceptance_scenarios": {"type": "array"}
            }
          }
        }
      }
    }
  }
}
