{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/authority/AUTHORITY_GRANT.schema.json",
 "$comment": "LOCAL ADDITION canon-review-and-escalation-v1 2026-07-31 - HARVEST TO CPB.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "contract_version", "grant_id", "issuer", "subject", "authority_class", "decision_classes", "scope", "valid_from", "valid_until", "delegation_hops", "grant_digest"],
 "properties": {
  "schema": {"const": "cpb-canon-review-and-escalation-v1/authority-grant"},
  "contract_version": {"const": "1"},
  "grant_id": {"type": "string", "pattern": "^AGR-[0-9a-f]{24}$"},
  "issuer": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/identity"},
  "subject": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/actor"},
  "authority_class": {"type": "string", "minLength": 1},
  "decision_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/decisionType"}},
  "scope": {
   "type": "object", "additionalProperties": false,
   "required": ["project_id", "candidate_token", "escalation_id"],
   "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "candidate_token": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/candidateToken"},
    "escalation_id": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/escalationId"}
   }
  },
  "valid_from": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/timestamp"},
  "valid_until": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/timestamp"},
  "delegation_hops": {"type": "integer", "minimum": 0, "maximum": 1},
  "grant_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}
 }
}