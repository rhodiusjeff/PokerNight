 "properties": {
  "schema": {"const": "cpb-canon-review-and-escalation-v1/forge-escalation-projection"},
  "contract_version": {"const": "1"},
    "trust": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/trustBinding"},
  "provider_namespace": {"const": "mock-forge-v1"},
  "repository_id": {"type": "string", "minLength": 1},
