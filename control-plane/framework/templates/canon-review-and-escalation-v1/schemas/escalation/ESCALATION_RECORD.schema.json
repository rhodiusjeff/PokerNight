{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/escalation/ESCALATION_RECORD.schema.json",
 "$comment": "LOCAL ADDITION canon-review-and-escalation-v1 2026-07-31 - HARVEST TO CPB.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "contract_version", "trust", "escalation_id", "project_id", "candidate", "report", "frontiers", "triggering_findings", "allowed_decisions", "required_authority_class", "eligible_identity_policy_ref", "due_boundary", "completion_impact", "projection_safe_summary", "candidate_producer_identity", "idempotency_key", "creation_provenance", "created_at", "escalation_digest"],
 "properties": {
  "schema": {"const": "cpb-canon-review-and-escalation-v1/escalation-record"},
  "contract_version": {"const": "1"},
  "trust": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/trustBinding"},
  "escalation_id": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/escalationId"},
    "project_id": {"type": "string", "minLength": 1},
  "candidate": {
   "type": "object", "additionalProperties": false, "required": ["token", "ref", "record_digest"],
   "properties": {
    "token": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/candidateToken"},
    "ref": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/gitSha"},
    "record_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}
   }
  },
  "report": {
   "type": "object", "additionalProperties": false, "required": ["report_id", "report_digest"],
   "properties": {
    "report_id": {"type": "string", "pattern": "^CHR-[0-9a-f]{24}$"},
    "report_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}
   }
  },
  "frontiers": {
   "type": "object", "additionalProperties": false, "required": ["input", "visibility"],
   "properties": {
    "input": {
     "type": "object", "additionalProperties": false, "required": ["digest", "candidate_ref", "canon_ref", "horizon_refs"],
     "properties": {
      "digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
      "candidate_ref": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/gitSha"},
      "canon_ref": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/gitSha"},
      "horizon_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["horizon_id", "ref"], "properties": {"horizon_id": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/horizonId"}, "ref": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/gitSha"}}}}
     }
    },
    "visibility": {
     "type": "object", "additionalProperties": false, "required": ["digest", "discovery_ref"],
     "properties": {"digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}, "discovery_ref": {"$ref": "https://control-plane.dev/schemas/semantic-authority-v1/semantic-authority.defs.schema.json#/$defs/gitSha"}}
    }
   }
  },
  "triggering_findings": {"type": "array", "minItems": 1, "items": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/reviewFinding"}},
  "allowed_decisions": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/decisionType"}},
  "required_authority_class": {"type": "string", "minLength": 1},
  "eligible_identity_policy_ref": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/artifactDigest"},
  "due_boundary": {"type": "string", "minLength": 1},
  "completion_impact": {"const": "blocks-candidate-disposition"},
  "projection_safe_summary": {"type": "string", "minLength": 1},
  "candidate_producer_identity": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/identity"},
  "idempotency_key": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
  "creation_provenance": {
   "type": "object", "additionalProperties": false, "required": ["runtime_version", "source_report_path", "network_used", "live_forge_used"],
   "properties": {"runtime_version": {"type": "string", "minLength": 1}, "source_report_path": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/repositoryPath"}, "network_used": {"const": false}, "live_forge_used": {"const": false}}
  },
  "created_at": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/timestamp"},
  "escalation_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}
 }
}