{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/escalation/STRUCTURED_DECISION.schema.json",
 "$comment": "LOCAL ADDITION canon-review-and-escalation-v1 2026-07-31 - HARVEST TO CPB.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "contract_version", "decision_id", "escalation_id", "escalation_digest", "candidate_digest", "report_digest", "decision", "rationale", "rationale_digest", "actor", "authority", "mock_forge_event_ref", "observed_at", "decision_digest"],
 "properties": {
  "schema": {"const": "cpb-canon-review-and-escalation-v1/structured-decision"},
  "contract_version": {"const": "1"},
  "decision_id": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/decisionId"},
  "escalation_id": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/escalationId"},
  "escalation_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
  "candidate_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
  "report_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
  "decision": {
   "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["type", "eligibility_boundary"], "properties": {"type": {"const": "approve-promotion"}, "eligibility_boundary": {"const": "package-c-eligibility-evaluation"}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "rejection_basis"], "properties": {"type": {"const": "reject-candidate"}, "rejection_basis": {"type": "string", "minLength": 1}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "required_revisions"], "properties": {"type": {"const": "revise-candidate"}, "required_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "boundary_or_date", "containment"], "properties": {"type": {"const": "defer-until"}, "boundary_or_date": {"type": "string", "minLength": 1}, "containment": {"type": "string", "minLength": 1}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "successor_reference"], "properties": {"type": {"const": "supersede-with"}, "successor_reference": {"type": "object", "additionalProperties": false, "required": ["candidate_token", "candidate_digest"], "properties": {"candidate_token": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/candidateToken"}, "candidate_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}}}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "destination", "due_boundary"], "properties": {"type": {"const": "transfer-forward"}, "destination": {"type": "string", "minLength": 1}, "due_boundary": {"type": "string", "minLength": 1}}}
   ]
  },
  "rationale": {"type": "string", "minLength": 1},
  "rationale_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"},
  "actor": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/actor"},
  "authority": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/authority/AUTHORITY_DELEGATION_ENVELOPE.schema.json"},
    "mock_forge_event_ref": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/forgeEventIdentityRef"},
  "observed_at": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/timestamp"},
  "decision_digest": {"$ref": "https://control-plane.dev/schemas/canon-review-and-escalation-v1/canon-review-and-escalation.defs.schema.json#/$defs/digest"}
 }
}